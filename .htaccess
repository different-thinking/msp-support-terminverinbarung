# Terminbuchungs-App – Apache Konfiguration

# Zugriff auf sensible Verzeichnisse blockieren
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /data/ nicht öffentlich zugänglich
    RewriteRule ^data/ - [F,L]

    # /src/ nicht öffentlich zugänglich
    RewriteRule ^src/ - [F,L]

    # config.php nicht direkt aufrufbar
    RewriteRule ^config\.php$ - [F,L]

    # Hübsche Funnel-URLs: /<slug> -> index.php?termin=<slug>
    # Greift nur, wenn der Pfad keine echte Datei/Verzeichnis ist (so bleibt
    # /admin/, /api/, /assets/, /calendar/ usw. erreichbar). Die Allowlist
    # gegen unbekannte Slugs uebernimmt PHP (FunnelManager).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9][a-z0-9-]{0,49})/?$ index.php?termin=$1 [L,QSA]
</IfModule>

# PHP-Fehler nicht im Browser anzeigen (Produktiv)
php_flag display_errors off
php_flag log_errors on
